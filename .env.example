# Moyasar hosted-invoice integration. Use test credentials locally and live
# credentials only in the production deployment. Do not commit real values.
# A publishable key (pk_...) is not needed because checkout uses a Moyasar
# hosted invoice; keep only the secret key on this backend.
MOYASAR_BASE_URL=https://api.moyasar.com/v1
MOYASAR_SECRET_KEY=sk_test_replace_with_a_new_secret_key

# Public backend endpoint that Moyasar POSTs to when an invoice is paid. This
# endpoint verifies the invoice and credits tokens. It must be reachable from
# the internet; do not use localhost in production.
MOYASAR_CALLBACK_URL=https://api.example.com/payment/webhook/moyasar

# Public frontend page where Moyasar redirects the customer after checkout. The
# service appends the paymentId query parameter automatically.
MOYASAR_RETURN_URL=https://app.example.com/payment-result

# Fallback base URL when no Moyasar callback URL has been configured. localhost
# is suitable only for local development without provider callbacks.
APP_BASE_URL=https://api.example.com
